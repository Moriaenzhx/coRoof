# Development only. Rules mode needs no external credentials.
POSTGRES_PASSWORD=coroof-local-only
POSTGRES_PORT=55432
REDIS_PORT=56379
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# For running Python directly instead of Compose:
COROOF_ENVIRONMENT=development
COROOF_DATABASE_URL=postgresql+psycopg://coroof:coroof-local-only@127.0.0.1:55432/coroof
COROOF_REDIS_URL=redis://127.0.0.1:56379/0
COROOF_WEB_ORIGIN=http://localhost:3000
COROOF_AUTH_MODE=mock
COROOF_AI_PROVIDER=rules
# Optional server-side model. See docs/slice02.md. Never put credentials in NEXT_PUBLIC_*.
COROOF_AI_BASE_URL=
COROOF_AI_MODEL=
COROOF_AI_API_KEY=
# bailian uses the general application API, not Coding Plan. See docs/model-layer.md.
# Set true only after scripts/model_acceptance.py passes for this exact endpoint/model.
COROOF_AI_MODEL_VERIFIED=false
COROOF_AI_TIMEOUT_SECONDS=25
COROOF_AI_MAX_INPUT_TOKENS=24000
COROOF_AI_MAX_OUTPUT_TOKENS=2500
COROOF_AI_DAILY_CALL_LIMIT=100
COROOF_AI_DAILY_TOKEN_LIMIT=200000
COROOF_AI_MONTHLY_TOKEN_LIMIT=6000000
COROOF_AI_CONCURRENCY_LIMIT=2
COROOF_AI_OUTPUT_MODE=schema
# Fernet deployment encryption key for tenant BYOK. Generate once and back it up securely.
# Leave empty to disable saving tenant credentials. Never use the LLM API key here.
COROOF_AI_SECRET_KEY=
# Exact HTTPS base URLs allowed in addition to provider defaults. No arbitrary tenant URLs.
COROOF_AI_ALLOWED_BASE_URLS=[]
# Explicit local synthetic test connections only; never enabled by default or in production.
# Keep tenant connection UUIDs here, never API keys. Background agents cannot use these.
COROOF_AI_DEVELOPMENT_TEST_CONNECTION_IDS=[]
COROOF_COOKIE_SECURE=false
# Connector defaults: https://gitlab.com and https://project.feishu.cn.
# Add exact self-hosted HTTPS origins only; no path/query or redirects.
COROOF_CONNECTOR_ALLOWED_BASE_URLS=[]
