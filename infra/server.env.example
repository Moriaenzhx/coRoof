# Copy outside the repository; chmod 600. No real credentials belong in this file.
# Use complete literal values; preflight/backup do not expand ${VARIABLE} references.
# Compose invocation: --env-file /absolute/private/server.env -f infra/compose.production.yaml
COROOF_SERVER_ENV_FILE=/absolute/private/server.env
COROOF_DOMAIN=workspace.example.com
POSTGRES_PASSWORD=
REDIS_PASSWORD=
COROOF_DATABASE_URL=postgresql+psycopg://coroof:URL_ENCODED_PASSWORD@postgres:5432/coroof
COROOF_REDIS_URL=redis://:URL_ENCODED_PASSWORD@redis:6379/0
COROOF_WEB_ORIGIN=https://workspace.example.com
COROOF_ENVIRONMENT=production
COROOF_AUTH_MODE=oidc
COROOF_COOKIE_SECURE=true
COROOF_OIDC_ISSUER=https://identity.example.com
COROOF_OIDC_CLIENT_ID=
COROOF_OIDC_CLIENT_SECRET=
COROOF_OIDC_SESSION_SECRET=
COROOF_OIDC_ALLOWED_HOSTS=[]
COROOF_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
COROOF_AUTH_SESSION_HOURS=24
COROOF_AUTH_RATE_LIMIT=10/minute
COROOF_INVITE_RATE_LIMIT=20/hour
COROOF_DELIVERY_MODE=smtp
COROOF_SMTP_HOST=
COROOF_SMTP_PORT=587
COROOF_SMTP_USERNAME=
COROOF_SMTP_PASSWORD=
COROOF_SMTP_FROM=
COROOF_SMTP_TLS=starttls
COROOF_MAIL_SECRET_KEY=
COROOF_AI_SECRET_KEY=
COROOF_AI_PROVIDER=rules
# Set only after real identity, recipient inbox, restore, tenant access and deployment review.
COROOF_PRODUCTION_RELEASE_VERIFIED=false
